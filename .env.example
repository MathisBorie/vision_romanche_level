# Copier ce fichier en .env et remplir. .env est ignoré par git.
# Fournisseur AWS : laisser S3_ENDPOINT_URL vide et mettre la région du bucket.
# Fournisseur R2  : S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com et AWS_REGION=auto
S3_BUCKET=romanche-mathis
S3_PREFIX=
S3_ENDPOINT_URL=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
